<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher in landscape: the menu on the left as two columns of pills,
     the game's state and the direct launch switch on the right, QUIT under
     them. The two columns are what keeps the whole menu reachable in the
     little height a phone has across. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/ConsoleTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_name" />

                            <TextView
                                style="@style/ConsoleCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:letterSpacing="0.16"
                                android:text="@string/wordmark_caption"
                                android:textAllCaps="true"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/version_tag"
                            style="@style/ConsoleCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textSize="11sp"
                            tools:text="0.2.2 · build 43 · EUROPE" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/play"
                        style="@style/ConsoleButton.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawableStart="@drawable/ic_play"
                        android:gravity="center"
                        android:text="@string/play"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/select_folder"
                            style="@style/ConsoleButton.Grid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_folder"
                            android:gravity="start|center_vertical"
                            android:text="@string/entry_select_folder" />

                        <Button
                            android:id="@+id/install"
                            style="@style/ConsoleButton.Grid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_disc"
                            android:gravity="start|center_vertical"
                            android:text="@string/entry_install" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/settings"
                            style="@style/ConsoleButton.Grid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_tune"
                            android:gravity="start|center_vertical"
                            android:text="@string/entry_settings" />

                        <Button
                            android:id="@+id/driver"
                            style="@style/ConsoleButton.Grid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_gpu"
                            android:gravity="start|center_vertical"
                            android:text="@string/graphics_driver" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/log"
                            style="@style/ConsoleButton.Grid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_log"
                            android:gravity="start|center_vertical"
                            android:text="@string/view_log" />

                        <Button
                            android:id="@+id/entry_updates"
                            style="@style/ConsoleButton.Grid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_update"
                            android:gravity="start|center_vertical"
                            android:text="@string/check_updates" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_console_card"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_default_title"
                            android:textColor="@color/ui_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/detail_text"
                            style="@style/ConsoleSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:maxLines="6"
                            android:text="@string/detail_default_text" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/ui_line" />

                        <TextView
                            style="@style/ConsoleCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:letterSpacing="0.16"
                            android:text="@string/ui_status"
                            android:textAllCaps="true"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/ui_text"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:id="@+id/direct_launch_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_console_card"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/direct_launch_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/direct_launch"
                        android:textColor="@color/ui_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        style="@style/ConsoleCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/direct_launch_hint"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/entry_quit"
                    style="@style/ConsoleButton.Stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_quit"
                    android:gravity="center"
                    android:text="@string/quit_launcher" />
            </LinearLayout>
        </LinearLayout>

        <!-- The help strip along the foot: device, driver and build, scrolling. -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/bg_console_footer"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="false"
            android:textColor="@color/ui_muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>
</FrameLayout>