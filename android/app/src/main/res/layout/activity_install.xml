<?xml version="1.0" encoding="utf-8"?>
<!-- Choosing where the game comes from. The chosen source is a card because it
     is a state, not an action; the three ways to change it are outlined pills,
     and the install button is the only filled control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SetupColumn"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_console_back_bar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/setup_gutter"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/setup_gutter"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/ConsoleCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_install_step" />

                <TextView
                    style="@style/ConsoleTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/install_game" />

                <TextView
                    style="@style/ConsoleSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/install_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_console_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/source_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_disc"
                        android:tint="@color/ui_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ConsoleCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_source_label" />

                        <TextView
                            android:id="@+id/source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:maxLines="3"
                            android:textColor="@color/ui_muted"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/choose_title"
                    style="@style/ConsoleCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/ui_choose_title" />

                <Button
                    android:id="@+id/pick"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_disc"
                    android:gravity="start|center_vertical"
                    android:text="@string/pick_with_files" />

                <Button
                    android:id="@+id/pick_folder"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_folder"
                    android:gravity="start|center_vertical"
                    android:text="@string/pick_folder" />

                <Button
                    android:id="@+id/choose"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_storage"
                    android:gravity="start|center_vertical"
                    android:text="@string/choose_source" />

                <Button
                    android:id="@+id/begin"
                    style="@style/ConsoleButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="@string/begin_install" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:max="1000"
                    android:progressBackgroundTint="@color/ui_line"
                    android:progressTint="@color/ui_green"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/progress_text"
                    style="@style/ConsoleSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/cancel"
                    style="@style/ConsoleButton.Stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/cancel"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
