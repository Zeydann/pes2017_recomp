<?xml version="1.0" encoding="utf-8"?>
<!-- Which Vulkan the game talks to. The driver in use is a card because it
     is a state; getting another one and picking a zip are the actions, and
     the imported drivers follow as a list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SetupColumn"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_console_back_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/setup_gutter"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/setup_gutter">

            <TextView
                style="@style/ConsoleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/graphics_driver" />

            <TextView
                android:id="@+id/driver_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_console_card"
                android:padding="14dp"
                android:textColor="@color/ui_text"
                android:textSize="13sp" />

            <TextView
                style="@style/ConsoleSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:text="@string/driver_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/download_driver"
                    style="@style/ConsoleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/download_driver" />

                <Button
                    android:id="@+id/import_driver"
                    style="@style/ConsoleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/import_driver" />

            </LinearLayout>

        </LinearLayout>

        <ListView
            android:id="@+id/driver_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:divider="@color/ui_line"
            android:dividerHeight="1dp"
            android:listSelector="@android:color/transparent"
            android:paddingStart="@dimen/setup_gutter"
            android:paddingEnd="@dimen/setup_gutter"
            android:paddingBottom="12dp"
            android:scrollbarStyle="insideOverlay" />

    </LinearLayout>
</LinearLayout>
