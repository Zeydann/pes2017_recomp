<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every screen outside the run. Dark because they hand straight over to
         the game's black surface; green is the forward action, red the
         stopping one. -->
    <style name="Theme.PES17.Console" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ui_bg</item>
        <item name="android:statusBarColor">@color/ui_bg</item>
        <item name="android:navigationBarColor">@color/ui_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/ui_surface_alt</item>
        <item name="colorPrimaryDark">@color/ui_bg</item>
        <item name="colorAccent">@color/ui_green</item>
        <item name="colorControlActivated">@color/ui_green</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="buttonStyle">@style/ConsoleButton</item>
        <item name="android:buttonStyle">@style/ConsoleButton</item>
        <item name="alertDialogTheme">@style/Theme.PES17.Dialog</item>
    </style>

    <!-- A question or the log, over the console: the same surface as the cards,
         not the platform's grey. -->
    <style name="Theme.PES17.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/ui_green</item>
        <item name="colorBackgroundFloating">@color/ui_surface</item>
        <item name="android:colorBackground">@color/ui_surface</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/ui_text</item>
        <item name="buttonBarButtonStyle">@style/ConsoleDialogButton</item>
    </style>

    <style name="ConsoleDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- The run: black behind the surface, and the dark pad editor over it. -->
    <style name="Theme.PES17.Game" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">#0E1A36</item>
        <item name="colorPrimaryDark">#070D1C</item>
        <item name="colorAccent">@color/pes_gold</item>
        <item name="android:textColorPrimary">#EAF1FF</item>
        <item name="android:textColorSecondary">#8FA0C2</item>
    </style>

    <!-- The setup screens' content column: the whole window, in either
         orientation. The side margin is setup_gutter, so the cards line up with
         the strip above them. -->
    <style name="SetupColumn">
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="ConsoleBack" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:drawableStart">@drawable/ic_chevron_left</item>
        <item name="android:drawableTint">@color/ui_muted</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ConsoleTitle">
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleSubtitle">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleCaption">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_console_button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/ui_green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ConsoleButton.Primary">
        <item name="android:background">@drawable/bg_console_primary</item>
        <item name="android:drawableTint">@color/console_primary_text</item>
        <item name="android:textColor">@color/console_primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ConsoleButton.Stop">
        <item name="android:background">@drawable/bg_console_stop</item>
        <item name="android:drawableTint">@color/ui_red</item>
        <item name="android:textColor">@color/ui_red</item>
    </style>

    <!-- The launcher's landscape menu: the same pill, narrow enough that two
         sit side by side without the label wrapping. -->
    <style name="ConsoleButton.Grid">
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- A secondary action that must not compete with the filled pill. -->
    <style name="ConsoleLink" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/ui_green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_green</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- A settings page's section heading: small, bold, directly above the
         card it names. -->
    <style name="ConsoleSection">
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- A group of settings: one surface, the hairline between rows is what
         separates them. -->
    <style name="ConsoleCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_console_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- One tab on a settings strip: the chosen one is white above a green
         rule, the rest stay muted. -->
    <style name="ConsoleTab" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_console_tab</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- The label of a setting, and the line of explanation under it. -->
    <style name="ConsoleRowLabel">
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleRowHint">
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleSwitch">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@color/ui_line</item>
    </style>
</resources>
