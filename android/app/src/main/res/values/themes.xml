<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The settings screens still to be moved over: a white page, navy type,
         red controls. -->
    <style name="Theme.PES17" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/pes_page</item>
        <item name="colorPrimary">@color/pes_navy</item>
        <item name="colorPrimaryDark">@color/pes_navy</item>
        <item name="colorAccent">@color/pes_red</item>
        <item name="colorControlActivated">@color/pes_red</item>
        <item name="android:textColorPrimary">@color/pes_text</item>
        <item name="android:textColorSecondary">@color/pes_muted</item>
        <item name="buttonStyle">@style/PanelButton</item>
        <item name="android:buttonStyle">@style/PanelButton</item>
    </style>

    <!-- Setup screens. Dark because they hand straight over to the game's
         black surface; green is the forward action, red the stopping one. -->
    <style name="Theme.PES17.Console" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ui_bg</item>
        <item name="android:statusBarColor">@color/ui_bg</item>
        <item name="android:navigationBarColor">@color/ui_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/ui_surface_alt</item>
        <item name="colorPrimaryDark">@color/ui_bg</item>
        <item name="colorAccent">@color/ui_green</item>
        <item name="colorControlActivated">@color/ui_green</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="buttonStyle">@style/ConsoleButton</item>
        <item name="android:buttonStyle">@style/ConsoleButton</item>
    </style>

    <!-- The run: black behind the surface, and the dark pad editor over it. -->
    <style name="Theme.PES17.Game" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">#0E1A36</item>
        <item name="colorPrimaryDark">#070D1C</item>
        <item name="colorAccent">@color/pes_gold</item>
        <item name="android:textColorPrimary">#EAF1FF</item>
        <item name="android:textColorSecondary">#8FA0C2</item>
    </style>

    <!-- A settings panel's header row: a solid bar, as the PES 6 menus' header strips. -->
    <style name="SectionHeading">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_section_bar</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- One setting: a row with a hairline under it, label on the left. -->
    <style name="SettingLabel">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/pes_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="SettingHint">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/pes_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingSwitch">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/pes_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- A card holding one group of settings (Display, Frame rate, ...). -->
    <style name="SettingGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_setting_group</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="TabEntry">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- BACK: gold italic capitals with an arrow, on the strip's navy. -->
    <style name="BackButton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/pes_gold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PanelButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_action</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- The setup screens' content column: full width in portrait, capped in
         values-land so a pill does not run the whole length of a wide screen. -->
    <style name="SetupColumn">
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="ConsoleBack" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:drawableStart">@drawable/ic_chevron_left</item>
        <item name="android:drawableTint">@color/ui_muted</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ConsoleTitle">
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleSubtitle">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleCaption">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ConsoleButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_console_button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/ui_green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ConsoleButton.Primary">
        <item name="android:background">@drawable/bg_console_primary</item>
        <item name="android:drawableTint">@color/console_primary_text</item>
        <item name="android:textColor">@color/console_primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ConsoleButton.Stop">
        <item name="android:background">@drawable/bg_console_stop</item>
        <item name="android:drawableTint">@color/ui_red</item>
        <item name="android:textColor">@color/ui_red</item>
    </style>

    <!-- The launcher's landscape menu: the same pill, narrow enough that two
         sit side by side without the label wrapping. -->
    <style name="ConsoleButton.Grid">
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- A secondary action that must not compete with the filled pill. -->
    <style name="ConsoleLink" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/ui_green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_green</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
