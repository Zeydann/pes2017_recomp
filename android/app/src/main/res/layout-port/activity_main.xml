<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher in portrait: the same dark console as the setup screens, so
     the menu, the folder picker and the install screen read as one app. The
     chosen entry's hint and the game's state share one card at the top, where
     they are visible without scrolling; the entries follow, then the direct
     launch switch, then QUIT on its own. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg">

    <LinearLayout
        style="@style/SetupColumn"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ConsoleTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textSize="26sp" />

                        <TextView
                            style="@style/ConsoleCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:letterSpacing="0.16"
                            android:text="@string/wordmark_caption"
                            android:textAllCaps="true"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/version_tag"
                        style="@style/ConsoleCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textSize="11sp"
                        tools:text="0.2.2 · build 43 · EUROPE" />
                </LinearLayout>

                <!-- The chosen entry and the game's state, as one card. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_console_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_default_title"
                        android:textColor="@color/ui_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/detail_text"
                        style="@style/ConsoleSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="6"
                        android:text="@string/detail_default_text" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/ui_line" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="5"
                        android:textColor="@color/ui_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <Button
                    android:id="@+id/play"
                    style="@style/ConsoleButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_play"
                    android:gravity="center"
                    android:text="@string/play"
                    android:textSize="16sp" />

                <TextView
                    style="@style/ConsoleCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:letterSpacing="0.16"
                    android:text="@string/ui_menu"
                    android:textAllCaps="true"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/select_folder"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_folder"
                    android:gravity="start|center_vertical"
                    android:text="@string/entry_select_folder" />

                <Button
                    android:id="@+id/install"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_disc"
                    android:gravity="start|center_vertical"
                    android:text="@string/entry_install" />

                <Button
                    android:id="@+id/settings"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_tune"
                    android:gravity="start|center_vertical"
                    android:text="@string/entry_settings" />

                <Button
                    android:id="@+id/driver"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_gpu"
                    android:gravity="start|center_vertical"
                    android:text="@string/graphics_driver" />

                <Button
                    android:id="@+id/log"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_log"
                    android:gravity="start|center_vertical"
                    android:text="@string/view_log" />

                <Button
                    android:id="@+id/entry_updates"
                    style="@style/ConsoleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_update"
                    android:gravity="start|center_vertical"
                    android:text="@string/check_updates" />

                <!-- A preference, not an action: the switch sits in a card with
                     its hint, and the whole card is hidden when there is no
                     game to start yet. -->
                <LinearLayout
                    android:id="@+id/direct_launch_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_console_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/direct_launch_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/direct_launch"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        style="@style/ConsoleCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/direct_launch_hint" />
                </LinearLayout>

                <Button
                    android:id="@+id/entry_quit"
                    style="@style/ConsoleButton.Stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_quit"
                    android:gravity="center"
                    android:text="@string/quit_launcher" />
            </LinearLayout>
        </ScrollView>

        <!-- The help strip along the foot: device, driver and build, scrolling. -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@drawable/bg_console_footer"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="false"
            android:textColor="@color/ui_muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>
</FrameLayout>