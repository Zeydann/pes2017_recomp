<?xml version="1.0" encoding="utf-8"?>
<!-- A source card: one surface, no shadow. The border is what separates it
     from the page, so the screen does not need a drop shadow on every item. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_surface" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/ui_line" />
</shape>
