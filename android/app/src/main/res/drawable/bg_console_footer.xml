<?xml version="1.0" encoding="utf-8"?>
<!-- The strip along the foot of the launcher: a hairline over a slightly
     lighter surface, so the build line reads as a footer, not a button. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_line" />
        </shape>
    </item>
</layer-list>