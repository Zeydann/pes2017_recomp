<?xml version="1.0" encoding="utf-8"?>
<!-- Focus is a green outline rather than a colour change alone, so a D-pad
     user can see where they are and a colour-blind player can see it too. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3354E08D">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1dp" android:color="@color/ui_line" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface_alt" />
                    <corners android:radius="26dp" />
                    <stroke android:width="2dp" android:color="@color/ui_green" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface_pressed" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1dp" android:color="@color/ui_line" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface_alt" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1dp" android:color="@color/ui_line" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
