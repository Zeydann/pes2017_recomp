<?xml version="1.0" encoding="utf-8"?>
<!-- The only red control on the setup screens: it stops a copy in progress. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF6B6B">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface_alt" />
                    <corners android:radius="26dp" />
                    <stroke android:width="2dp" android:color="@color/ui_red" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1dp" android:color="@color/ui_red" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
