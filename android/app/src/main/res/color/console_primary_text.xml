<?xml version="1.0" encoding="utf-8"?>
<!-- The filled button is dark green text on green; when it is disabled it sits
     on a dark surface, so it switches to the muted colour rather than
     disappearing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ui_muted" android:state_enabled="false" />
    <item android:color="@color/ui_on_green" />
</selector>
